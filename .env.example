# Supabase Configuration Variables
# Copy this file to .env and fill in your values
# NEVER commit your real .env file!

SUPABASE_URL="your_supabase_url"
SUPABASE_ANON_KEY="your_supabase_anon_key"

# Frontend (Vite) environment variables — these are embedded in the browser bundle
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"
# Optional: override the full function endpoint URL (defaults to https://<project>.supabase.co/functions/v1/make-server-25b11ac0)
VITE_SUPABASE_FUNCTION_ENDPOINT=""

# Server-side Edge Function secrets — NEVER prefix these with VITE_ (they must stay server-only)
# Used by the Edge Function at runtime (Supabase Secrets dashboard or CLI):
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<value>
# DO NOT add VITE_SUPABASE_FN_SECRET — authentication is handled via Authorization Bearer (JWT).

# Application Settings
APP_ENV="development"
APP_DEBUG="true"
APP_PORT="3000"