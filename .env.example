# =============================================
# Event Waitstaff Management – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env file.
# =============================================

# --- App ---
VITE_APP_ENV=development
VITE_LOG_LEVEL=info
VITE_API_TIMEOUT=5000
VITE_MAX_RETRIES=3

# --- Supabase ---
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-anon-key
# Secret used to authorise mutation endpoints (POST/PUT/DELETE)
VITE_SUPABASE_FN_SECRET=your-function-secret

# --- Email (server-side Supabase secrets – not VITE_* prefixed) ---
# Option 1 – Resend (recommended)
RESEND_API_KEY=re_xxxxx
# Option 2 – SendGrid
SENDGRID_API_KEY=SG.xxxxx
# Option 3 – Mailgun
MAILGUN_API_KEY=xxxxx
MAILGUN_DOMAIN=yourdomain.com
# Shared
EMAIL_FROM=your@email.com

# --- WhatsApp Business API (server-side Supabase secrets) ---
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_KEY=your-api-key