# Supabase Configuration Variables
# Copy this file to .env and fill in your values
# NEVER commit your real .env file!

# Supabase project credentials
VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Optional: override the computed Supabase Function endpoint
# VITE_SUPABASE_FUNCTION_ENDPOINT="https://<project-id>.supabase.co/functions/v1/make-server-25b11ac0"

# Application Settings
APP_ENV="development"
APP_DEBUG="true"
APP_PORT="3000"

# Production URLs
# Frontend: https://appservice.jcarrizo.com
# API:      https://<project-id>.supabase.co/functions/v1/make-server-25b11ac0

# Authentication
# The frontend uses Supabase email/password login (JWT Bearer token).
# No VITE_SUPABASE_FN_SECRET is required; the JWT from Supabase Auth is used instead.
