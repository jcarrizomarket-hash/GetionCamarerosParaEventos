# =============================================================
# Environment Variable Examples
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file!
# =============================================================

# --- Supabase Project (required) ---
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Option A: Custom domain deployment ---
# Frontend is deployed at https://appservice.jcarrizo.com
# The API is served by Supabase Edge Functions.
# Override the auto-derived URL only if you use a custom Functions domain:
# VITE_SUPABASE_FUNCTION_ENDPOINT="https://your-project-id.supabase.co/functions/v1/make-server-25b11ac0"

# --- Application Settings ---
APP_ENV="development"    # "development" | "production"
APP_DEBUG="true"
APP_PORT="3000"

# --- Supabase Edge Function secrets (server-side only; set via `supabase secrets set`) ---
# SUPABASE_URL            – injected automatically by Supabase
# SUPABASE_ANON_KEY       – injected automatically by Supabase
# SUPABASE_SERVICE_ROLE_KEY – injected automatically by Supabase
# WHATSAPP_API_KEY        – Meta WhatsApp Business API token
# WHATSAPP_PHONE_ID       – Meta Phone Number ID
# RESEND_API_KEY          – Resend email API key (or SENDGRID_API_KEY / MAILGUN_API_KEY)
# EMAIL_FROM              – Sender email address

# NOTE: VITE_SUPABASE_FN_SECRET is no longer required.
# Sensitive endpoints are now protected by Supabase JWT (email/password auth).
# See README.md § Authentication and § Deployment for details.
