# Frontend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your real .env file!
#
# Frontend URL: https://appservice.jcarrizo.com
# API: Supabase Edge Functions (see VITE_SUPABASE_FUNCTION_ENDPOINT below)

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase Project ID (found in project settings)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Public anon key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: override the full Edge Function URL
# Defaults to https://<VITE_SUPABASE_PROJECT_ID>.supabase.co/functions/v1/make-server-25b11ac0
# VITE_SUPABASE_FUNCTION_ENDPOINT=https://your-project-id.supabase.co/functions/v1/make-server-25b11ac0

# ── Security ─────────────────────────────────────────────────────────────────
# Shared secret for mutation endpoints (POST/PUT/DELETE)
# Generate with: openssl rand -hex 32
# Must also be set in Supabase function secrets:
#   supabase secrets set SUPABASE_FN_SECRET=<value>
VITE_SUPABASE_FN_SECRET=your_function_secret

# ── Application Settings ─────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000