# Example Configuration — copy to .env and fill in real values
# NEVER commit .env to version control

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_FUNCTION_ENDPOINT=https://your-project.supabase.co/functions/v1/make-server-25b11ac0

# App
VITE_APP_ENV=development
VITE_LOG_LEVEL=info
VITE_API_TIMEOUT=5000
VITE_MAX_RETRIES=3

# Server-side (Supabase Functions / Deno)
SUPABASE_FN_SECRET=your_function_secret
ALLOWED_ORIGINS=https://your-frontend-domain.com
RESEND_API_KEY=your_resend_api_key
