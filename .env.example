# ============================================================
# .env.example — Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ============================================================

# --- Supabase ---
# Project ID (found in Supabase dashboard → Settings → General)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# Public anon key (found in Supabase dashboard → Settings → API)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: override the full function endpoint URL
# Defaults to: https://<VITE_SUPABASE_PROJECT_ID>.supabase.co/functions/v1/make-server-25b11ac0
VITE_SUPABASE_FUNCTION_ENDPOINT=

# Optional: secret header for mutating operations (POST/PUT/DELETE)
VITE_SUPABASE_FN_SECRET=

# --- Application ---
VITE_APP_ENV=production
VITE_LOG_LEVEL=info
VITE_API_TIMEOUT=5000
VITE_MAX_RETRIES=3