# Supabase Configuration (Required)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Function Endpoint (auto-generated from PROJECT_ID if not set)
# VITE_SUPABASE_FUNCTION_ENDPOINT=https://your-project-id.supabase.co/functions/v1/make-server-25b11ac0

# Security (Recommended for production)
# VITE_SUPABASE_FN_SECRET=your-function-secret

# App Configuration
VITE_APP_ENV=development
VITE_LOG_LEVEL=debug
VITE_API_TIMEOUT=5000
VITE_MAX_RETRIES=3