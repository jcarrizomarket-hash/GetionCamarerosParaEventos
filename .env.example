# Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file!
# All variables prefixed with VITE_ are bundled into the browser build.

# --- Supabase project ---
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- API endpoint (Supabase Functions) ---
# Full URL to the deployed Edge Function.
# If omitted, it is derived automatically from VITE_SUPABASE_PROJECT_ID.
VITE_SUPABASE_FUNCTION_ENDPOINT="https://your-supabase-project-id.supabase.co/functions/v1/make-server-25b11ac0"

# NOTE: Do NOT add any shared secret here.
# The frontend authenticates exclusively with the Supabase anon JWT
# sent as "Authorization: Bearer <VITE_SUPABASE_ANON_KEY>" on every request.
# Server-side secrets (SUPABASE_SERVICE_ROLE_KEY, WHATSAPP_API_KEY, etc.)
# must only be set in the Supabase Functions secrets — never in this file.