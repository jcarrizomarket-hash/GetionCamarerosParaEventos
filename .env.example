# Supabase configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Project ID found in: Supabase Dashboard → Project Settings → General
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# Anon/public key found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# (Optional) Full edge-function base URL.
# If omitted, it is derived automatically from VITE_SUPABASE_PROJECT_ID.
# Example: https://<project_id>.supabase.co/functions/v1/make-server-25b11ac0
VITE_SUPABASE_FUNCTION_ENDPOINT=

# Secret for protecting mutating endpoints (POST/PUT/DELETE).
# Generate with: openssl rand -hex 32
# Set the same value as SUPABASE_FN_SECRET in your Supabase Function secrets.
VITE_SUPABASE_FN_SECRET=

# Environment (development | production)
# Controls log verbosity: 'development' shows debug logs; 'production' shows warn/error only.
VITE_ENVIRONMENT=development

# WhatsApp API key (keep in Supabase Vault in production, not in .env)
# WHATSAPP_API_KEY=
