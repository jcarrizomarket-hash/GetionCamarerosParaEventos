# Environment Variables for Event Waitstaff Management System
# Copy this file to .env and fill in your values
# NEVER commit your real .env file!

# ─── Supabase (Frontend) ────────────────────────────────────────────────────
# Your Supabase project ID (found in Project Settings → General)
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Your Supabase anonymous/public API key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Secret shared between frontend and Edge Function for mutating endpoints
VITE_SUPABASE_FN_SECRET="your-function-secret"

# (Optional) Override the full Edge Function URL. Defaults to:
#   https://<VITE_SUPABASE_PROJECT_ID>.supabase.co/functions/v1/make-server-25b11ac0
# VITE_SUPABASE_FUNCTION_ENDPOINT="https://<project-id>.supabase.co/functions/v1/make-server-25b11ac0"

# ─── Application ─────────────────────────────────────────────────────────────
# Production frontend URL: https://appservice.jcarrizo.com
# API (Supabase Edge Functions): https://<project-id>.supabase.co/functions/v1/make-server-25b11ac0
VITE_APP_ENV="development"