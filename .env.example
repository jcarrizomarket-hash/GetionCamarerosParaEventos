# Supabase Configuration Variables
# Copy this file to .env and fill in your values
# NEVER commit your real .env file!
#
# ⚠️  VITE PREFIX REQUIRED
# This project uses Vite (not Next.js). Only variables prefixed with VITE_ are
# bundled into the browser build. Do NOT use NEXT_PUBLIC_* prefixes — they will
# be silently ignored and the app will fail to connect to Supabase.
#
# When deploying to Vercel, set these variable names exactly as shown below
# (with the VITE_ prefix) in Vercel → Project → Settings → Environment Variables.

# ── Required on Vercel (and locally) ──────────────────────────────────────────

# Full Supabase project URL (e.g. https://abcdefghijklmnop.supabase.co)
# Vercel <> Supabase integration sets this automatically.
VITE_SUPABASE_URL="https://your_project_id.supabase.co"

# Supabase anon/public key (JWT, used as Bearer token for all API calls)
# Vercel <> Supabase integration sets this automatically.
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# ── Optional overrides ─────────────────────────────────────────────────────────

# Supabase project ID (legacy; only needed if VITE_SUPABASE_URL is not set)
# VITE_SUPABASE_PROJECT_ID="your_supabase_project_id"

# Base URL for all Supabase Edge Functions (e.g. https://your_project.supabase.co/functions/v1)
# Defaults to <VITE_SUPABASE_URL>/functions/v1 when not set.
# Set this on Vercel if you need to point to a custom functions domain.
# VITE_SUPABASE_FUNCTIONS_URL="https://your_project.supabase.co/functions/v1"

# Full URL for a specific function endpoint (highest-priority override)
# Defaults to <VITE_SUPABASE_FUNCTIONS_URL>/make-server-25b11ac0
# VITE_SUPABASE_FUNCTION_ENDPOINT="https://your_project.supabase.co/functions/v1/make-server-25b11ac0"

# Application Settings
APP_ENV="development"
APP_DEBUG="true"
APP_PORT="3000"

# ── Supabase Edge Function secrets (set in Supabase dashboard, NOT in .env) ───
# SUPABASE_URL               – set automatically by Supabase runtime
# SUPABASE_SERVICE_ROLE_KEY  – set automatically by Supabase runtime
# RESEND_API_KEY             – email delivery via Resend
# EMAIL_FROM                 – sender address (e.g. noreply@yourdomain.com)
# WHATSAPP_API_KEY           – Meta Cloud API long-lived token (200+ chars, starts with EAA...)
# WHATSAPP_PHONE_ID          – Meta Business phone number ID (numeric, different from the token)
# WHATSAPP_VERIFY_TOKEN      – webhook verification token
