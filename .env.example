# Supabase configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ============================================================
# FRONTEND (Vite) - Variables prefijadas con VITE_
# ============================================================

# REQUIRED: Project ID found in: Supabase Dashboard → Project Settings → General
VITE_SUPABASE_PROJECT_ID=your_project_id_here

# REQUIRED: Anon/public key found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# (Optional) Full edge-function base URL.
# If omitted, it is derived automatically from VITE_SUPABASE_PROJECT_ID.
# Example: https://<project_id>.supabase.co/functions/v1/make-server-25b11ac0
VITE_SUPABASE_FUNCTION_ENDPOINT=

# ============================================================
# BACKEND (Supabase Edge Functions) - Set via Supabase Secrets
# See: supabase secrets set KEY=value
# ============================================================

# REQUIRED: Supabase service role key (from Dashboard → Settings → API)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# REQUIRED: Auto-provided by Supabase runtime
# SUPABASE_URL=https://<project_id>.supabase.co

# RECOMMENDED: Secret for protecting mutating endpoints (POST/PUT/DELETE)
# Generate a strong random value: openssl rand -hex 32
# SUPABASE_FN_SECRET=your_strong_secret_here

# Optional: WhatsApp Business API (Meta)
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_API_TOKEN=your_api_token
# WHATSAPP_VERIFY_TOKEN=your_verify_token
# WHATSAPP_APP_SECRET=your_app_secret

# Optional: Email providers (at least one required for email features)
# RESEND_API_KEY=re_your_resend_api_key
# SENDGRID_API_KEY=SG.your_sendgrid_api_key
# MAILGUN_API_KEY=your_mailgun_api_key
# MAILGUN_DOMAIN=your_mailgun_domain
# EMAIL_FROM=noreply@yourdomain.com
